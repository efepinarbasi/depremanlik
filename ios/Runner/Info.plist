	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Size en yakın depremleri filtreleyebilmemiz için konum bilginize ihtiyaç duyuyoruz.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Arka planda yakınınızda olan depremleri size bildirebilmek için konum izni gereklidir.</string>
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Deprem anında size en hızlı uyarıyı göndermek için konumunuzu takip etmemiz gerekebilir.</string>

	<!-- Arka Plan Modları (Workmanager/Bildirimler için) -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>

	<!-- URL Launcher (Tarayıcı açmak için) -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>https</string>
		<string>http</string>
	</array>

	<!-- AdMob App ID -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-9538379870086064~3857110879</string>
